/*
 * ============================================================================
 *  conf/base.config: Process resource labels and publishing conventions
 * ============================================================================
 *  Conservative defaults tailored for 16 GB RAM WSL2 Ubuntu systems.
 */

process {
    cpus   = 1
    memory = 2.GB
    time   = 1.h

    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 143, 247] ? 'retry' : 'finish' }
    maxRetries    = 1

    withLabel: 'process_single' {
        cpus   = 1
        memory = 2.GB
    }
    withLabel: 'process_low' {
        cpus   = 2
        memory = 4.GB
    }
    withLabel: 'process_medium' {
        cpus   = 2
        memory = 6.GB
    }
    withLabel: 'process_high' {
        cpus   = 4
        memory = 10.GB
    }
}
