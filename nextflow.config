/*
 * ============================================================================
 *  nextflow-clinical-ngs: Root Configuration
 * ============================================================================
 */

params {
    // Core input / output parameters
    input               = "${projectDir}/data/test/samplesheet.csv"
    analysis            = 'all' // 'germline' | 'tumor_normal' | 'tumor_only' | 'all'
    reference           = "${projectDir}/data/test/reference/reference.fa"
    outdir              = 'results'

    // Optional resource files & toggles
    run_bqsr            = false
    known_sites         = "${projectDir}/data/test/resources/known_sites.vcf"
    germline_resource   = "${projectDir}/data/test/resources/germline_resource.vcf"
    pon                 = "${projectDir}/data/test/resources/pon.vcf"
    run_orientation     = true

    // Resource ceilings (tuned for a 16 GB WSL2 Ubuntu workstation)
    max_cpus            = 4
    max_memory          = '12.GB'
    max_time            = '4.h'
}

// Load base process configuration
includeConfig 'conf/base.config'

// Execution profiles
profiles {
    docker {
        includeConfig 'conf/docker.config'
    }
    local {
        includeConfig 'conf/local.config'
    }
    test {
        includeConfig 'conf/test.config'
    }
}

// Pipeline execution reports (Milestone 6)

timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_report.html"
}
trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_trace.txt"
}
dag {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/pipeline_dag.svg"
}

manifest {
    name            = 'nextflow-clinical-ngs'
    author          = 'Huy Vuong'
    homePage        = 'https://github.com/huyvuong/nextflow-clinical-ngs'
    description     = 'Modular Nextflow DSL2 clinical NGS meta-pipeline for germline, matched tumor-normal, and tumor-only variant calling'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.04.0'
    version         = '0.8.0'
}
